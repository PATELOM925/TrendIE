# Local-only URL for the Fastify gateway. The web server rejects non-loopback hosts.
GATEWAY_BASE_URL=http://127.0.0.1:3000

# Use unique synthetic values for local development. Never expose these as NEXT_PUBLIC_*.
API_KEY_DASHBOARD=replace-with-local-dashboard-key
API_KEY_AGENT=replace-with-local-agent-key
DEMO_OWNER_ID=local-demo-owner
