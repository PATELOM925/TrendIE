{
  "name": "gateway",
  "version": "1.0.0",
  "description": "Agentic Payment Guard — Security Gateway",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "NODE_ENV=test TEST_DATABASE_URL=postgresql://unit:unit@127.0.0.1:5432/gateway_test APPROVAL_HMAC_SECRET=unit-only-secret-with-at-least-32-characters APPROVAL_KEY_ID=unit CORS_ORIGINS=http://localhost:3000 API_KEY_AGENT=unit-agent API_KEY_ADAPTER_GOAT=unit-goat API_KEY_ADAPTER_QATOM=unit-qatom API_KEY_DASHBOARD=unit-dashboard API_KEY_ADMIN=unit-admin TEST_SUITE=unit vitest run",
    "test:integration": "NODE_ENV=test TEST_SUITE=integration vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
