# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_guard
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_guard_test

# Approvals & HMAC
APPROVAL_HMAC_SECRET=dev-hmac-secret-min-32-characters-long-key-12345
APPROVAL_KEY_ID=key_v1
APPROVAL_TTL_SECONDS=300

# Service API Keys (per role)
API_KEY_AGENT=agent-secret-key-123
API_KEY_ADAPTER_GOAT=goat-adapter-secret-key-456
API_KEY_ADAPTER_QATOM=qatom-adapter-secret-key-789
API_KEY_DASHBOARD=dashboard-secret-key-012
API_KEY_ADMIN=admin-secret-key-999
